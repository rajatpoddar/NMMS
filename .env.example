# NMMS Tracking Report - Environment Config
# ============================================
# Copy this to .env and customize:
#   cp .env.example .env

# --- Server Port ---
# The port the Flask server listens on
HOST_PORT=6667

# --- PostgreSQL Database (Docker) ---
DB_PASSWORD=nmms_password

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=info

# --- License ---
TRIAL_DAYS=30

# --- Desktop Client ---
# On the desktop machine, set:
#   export NMMS_SERVER_URL=https://nmms.palojori.in
# Or create ~/.nmms_config.json with:
#   {"server_url": "https://nmms.palojori.in"}
